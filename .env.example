# Daily Manna Email - Environment Configuration Example
# Copy to .env and fill in your values

# Email Configuration
SMTP_USER=your-email@gmail.com
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# Admin Dashboard
ADMIN_DASHBOARD_PASSWORD=secure-password-here

# Admin Summary Email
ADMIN_SUMMARY_TO=admin@example.com
ADMIN_SUMMARY_FROM=noreply@example.com

# Content Source Management
# Disable specific content sources (comma-separated)
# Example: DISABLED_CONTENT_SOURCES=ezoe
# Use when a source is blocked or unavailable
# DISABLED_CONTENT_SOURCES=

# Feature Flags
DEBUG_MODE=0
TEST_MODE=0
CAFFEINE_MODE=0

# OAuth & Encryption
OAUTH_ENCRYPTION_KEY=your-encryption-key-here
EMAIL_ENCRYPTION_KEY=your-encryption-key-here

# Server
ADMIN_DASHBOARD_PASSWORD=your-password
